 "sentences": [
  [
   0.4,
   2.68,
   "What if Earth stopped spinning?"
  ],
  [
   3.04,
   4.56,
   "Right now, you're moving."
  ],
  [
   4.96,
   10.48,
   "At the equator, Earth's surface spins at about sixteen hundred and seventy kilometers per hour."
  ],
  [
   10.72,
   11.84,
   "You just can't feel it."
  ],
  [
   12.4,
   14.16,
   "Now imagine it slowing down."
  ],
  [
   14.72,
   16.16,
   "The days get longer."
  ],
  [
   16.64,
   17.92,
   "It's already happening."
  ],
  [
   18.16,
   21.68,
   "Every century, the day gets about two milliseconds longer."
  ],
  [
   21.92,
   26.42,
   "One point four billion years ago, a day lasted only about eighteen hours."
  ],
  [
   27.76,
   29.48,
   "Then it stops."
  ],
  [
   29.76,
   32.36,
   "Now one day lasts a whole year."
  ],
  [
   32.56,
   35.2,
   "The Sun would rise and set just once a year."
  ],
  [
   35.68,
   37.0,
   "Six months of daylight."
  ],
  [
   37.2,
   38.24,
   "Six months of night."
  ],
  [
   38.64,
   40.52,
   "The Sun hangs in the sky."
  ],
  [
   40.72,
   41.8,
   "It doesn't move."
  ],
  [
   42.0,
   43.52,
   "The ground bakes."
  ],
  [
   43.76,
   47.2,
   "Without the spin, Earth's oceans would drain toward the poles."
  ],
  [
   47.6,
   50.76,
   "Then, finally, the Sun starts to set."
  ],
  [
   50.96,
   52.48,
   "And the night begins."
  ],
  [
   52.72,
   57.04,
   "With no sunlight for months, the night side would plunge far below freezing."
  ],
  [
   57.36,
   61.718,
   "For anything that hunts in the dark, this is the longest night there has ever been."
  ],
  [
   63.64,
   65.802,
   "And something has been waiting for it."
  ],
  [
   68.341,
   69.061,
   "Wait."
  ]
